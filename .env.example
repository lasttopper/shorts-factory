# ── SHORTS FACTORY — credentials template ─────────────────────────────
# Copy to .env (or just pull from the shared Drive folder) and fill in.
# Everything is optional: with no keys the pipeline runs in SIMULATION.

# Database (provided by the platform)
# Runtime URL (use Neon's pooled / -pooler endpoint in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Schema setup URL (use Neon's direct endpoint in production)
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Source channel & cadence
SOURCE_CHANNEL_HANDLE=@NotYourType
SOURCE_CHANNEL_ID=
SHORTS_PER_RUN=10
SCHEDULE_START_HOUR=9
SLOT_INTERVAL_MIN=90
CLIP_MIN_SEC=34
CLIP_MAX_SEC=56

# YouTube Data API — live channel scanning
YOUTUBE_API_KEY=

# Shared Google Web OAuth app — users click "Connect with YouTube"
# Add exactly: ${APP_URL}/api/oauth/youtube/callback as an authorized redirect URI.
APP_URL=http://localhost:3000
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Legacy fallback only; new multi-user connections store an encrypted token per account.
YT_REFRESH_TOKEN=
YOUTUBE_UPLOAD_ENABLED=false

# AI copywriter (titles / descriptions / captions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram report delivery (@BotFather token + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive collab vault (.env + memory.md sync)
GDRIVE_FOLDER_ID=
GOOGLE_DRIVE_TOKEN=
