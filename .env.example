# ── SHORTS FACTORY — credentials template ─────────────────────────────
# Copy to .env (or set on your host) and fill in. Everything is optional:
# with no keys the pipeline runs in SIMULATION.

# Database (Neon: use the POOLED url here, the DIRECT url below)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Session signing + encryption of per-user YouTube tokens (NEVER change after go-live)
AUTH_SECRET=

# Source channel & cadence defaults
SOURCE_CHANNEL_HANDLE=@NotYourType
SHORTS_PER_RUN=10
SCHEDULE_START_HOUR=9
SLOT_INTERVAL_MIN=90
CLIP_MIN_SEC=34
CLIP_MAX_SEC=56

# YouTube Data API — live channel scanning
YOUTUBE_API_KEY=

# Shared Google Web OAuth app — powers per-user "Connect with YouTube"
APP_URL=http://localhost:3000
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# AI copywriter (titles / descriptions / captions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram report delivery (@BotFather token)
TELEGRAM_BOT_TOKEN=

# State on GitHub (memory.md + batch reports) instead of Google Drive
GITHUB_TOKEN=
GITHUB_STATE_REPO=lasttopper/shorts-factory

# Daily auto-run endpoint protection
CRON_SECRET=
